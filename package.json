{
  "name": "orkstage-site",
  "private": true,
  "version": "0.1.0",
  "description": "orkstage.io: landing page and documentation (static export for S3 + CloudFront)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/generate-api-reference.mjs",
    "dev": "next dev --port 3100",
    "prebuild": "node scripts/generate-api-reference.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/fix-segment-files.mjs",
    "pretypecheck": "node scripts/generate-api-reference.mjs",
    "typecheck": "next typegen && tsc --noEmit && pnpm run check:i18n && pnpm run check:prose",
    "lint": "biome lint --error-on-warnings .",
    "check:i18n": "node --no-warnings scripts/check-i18n.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "check:site": "node scripts/check-site.mjs",
    "serve": "node scripts/serve.mjs",
    "openapi:refresh": "node scripts/refresh-openapi.mjs && node scripts/generate-api-reference.mjs",
    "changelog:refresh": "node scripts/refresh-changelog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@swc/helpers": "^0.5.23",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.8",
    "fumadocs-openapi": "12.5.3",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "1.52.0",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
